# Single-bot setup without a config file (same variables as v1).
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
API_KEY=your-docsgpt-agent-api-key
# API_KEY_SUPPORT=another-agent-key      # extra agents: #support question
# API_KEY_SALES=another-agent-key
# API_BASE=https://gptcloud.arc53.com    # self-hosted DocsGPT URL

# Storage: sqlite by default (SQLITE_PATH), or STORAGE_TYPE=mongodb / memory
# SQLITE_PATH=data/docsgpt-telegram.db
# STORAGE_TYPE=mongodb
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=telegram_bot_memory
# MONGODB_COLLECTION_NAME=chat_histories

# Behaviour
# GROUPS_MODE=mention                    # mention | all | off
# STREAMING=true
# VOICE_REPLIES=false
# WELCOME_TEXT=Hi {name}! Ask me anything.
# MENU_BUTTON_URL=https://your-widget.example.com

# Webhook mode (otherwise long polling)
# WEBHOOK_PUBLIC_URL=https://bots.example.com
# WEBHOOK_SECRET=change-me
# HTTP_BIND=0.0.0.0:8080

# Logging
# RUST_LOG=info
# LOG_FORMAT=json
